  "cards": [
    {
      "dot": "cyan",
      "title": "Why this is deterministic",
      "items": [
        "No model client is reachable from the replay import graph",
        "Waiting is on expected state, never a fixed duration",
        "The first tier matching exactly one control wins"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail closed",
      "items": [
        "Reversibility comes from the control, not the file",
        "Two detectors matching at once is a hard failure, never a guess",
        "Irreversible actions escalate to a human instead of proceeding"
      ]
    }
  ]
